{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracelane://schemas/evidence-import-metadata/v1",
  "title": "TraceLane Evidence Import Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "content_sha256", "project_id", "session_id", "manifest_sha256", "candidates"],
  "$defs": {
    "candidate_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_spec_id", "candidate_id", "candidate_record_sha256", "candidate_content_sha256", "source_type", "license_basis", "content_authorship", "retention_policy", "domains", "fact_ids", "role"],
      "properties": {
        "source_spec_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "candidate_id": {"type": "string", "pattern": "^candidate_[0-9a-f]{24}$"},
        "candidate_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_type": {"enum": ["primary", "secondary", "dataset"]},
        "license_basis": {"type": "string", "minLength": 1},
        "content_authorship": {"enum": ["repository_authored", "third_party"]},
        "retention_policy": {"enum": ["paraphrase_only", "public_domain_full_text", "licensed_full_text"]},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role": {"enum": ["evidence", "future-control"]}
      }
    }
  },
  "properties": {
    "schema_id": {"const": "tracelane://schemas/evidence-import-metadata/v1"},
    "schema_version": {"const": "1.0.0"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "session_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidate_row"}}
  }
}
