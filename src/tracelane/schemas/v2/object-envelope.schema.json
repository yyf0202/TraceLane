{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracelane://schemas/object-envelope/v2",
  "title": "TraceLane v2 Object Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "object_id",
    "created_at",
    "content_sha256"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "pattern": "^tracelane://schemas/[a-z0-9][a-z0-9-]*/v[0-9]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}_[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
