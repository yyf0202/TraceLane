{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracelane://schemas/evidence-review/v1",
  "title": "TraceLane Evidence Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_sha256",
    "review_id",
    "project_id",
    "candidate_id",
    "candidate_record_sha256",
    "decision",
    "reason",
    "reviewer",
    "reviewed_at",
    "approved_fact_ids",
    "approved_domains",
    "license_basis",
    "retention_policy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approved"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "approved_fact_ids": {
            "minItems": 1
          },
          "approved_domains": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "rejected",
              "superseded"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "approved_fact_ids": {
            "maxItems": 0
          },
          "approved_domains": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "schema_id": {
      "const": "tracelane://schemas/evidence-review/v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^review_[0-9a-f]{24}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate_[0-9a-f]{24}$"
    },
    "candidate_record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "approved_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "license_basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "retention_policy": {
      "enum": [
        "paraphrase_only",
        "public_domain_full_text",
        "licensed_full_text"
      ]
    },
    "supersedes_review_id": {
      "type": "string",
      "pattern": "^review_[0-9a-f]{24}$"
    }
  }
}
