{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracelane://schemas/evidence-project/v1",
  "title": "TraceLane Evidence Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "record_sha256", "project_id", "title", "research_question", "historical_cutoff_at", "intervention", "required_domains", "future_control_policy", "admitted_source_types", "status"],
  "properties": {
    "schema_id": {"const": "tracelane://schemas/evidence-project/v1"},
    "schema_version": {"const": "1.0.0"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "historical_cutoff_at": {"type": "string", "format": "date-time"},
    "intervention": {"type": "string", "minLength": 1},
    "required_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "future_control_policy": {"const": "exclude_from_clean"},
    "admitted_source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["primary", "secondary", "dataset"]}},
    "status": {"enum": ["active", "paused", "completed", "archived"]}
  }
}
