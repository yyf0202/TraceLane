{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracelane://schemas/migration-manifest/v2",
  "title": "TraceLane v1 Import Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "content_sha256",
    "import_id",
    "source_format",
    "source_run_id",
    "imported_at",
    "entries",
    "source_root_sha256",
    "payload_root_sha256"
  ],
  "properties": {
    "schema_id": {"const": "tracelane://schemas/migration-manifest/v2"},
    "schema_version": {"const": "2.0.0"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "import_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "source_format": {"const": "tracelane-v1"},
    "source_run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "imported_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)[a-z0-9][a-zA-Z0-9._/-]*$"
          },
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "source_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 identity of the normalized absolute source root"
    },
    "payload_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
