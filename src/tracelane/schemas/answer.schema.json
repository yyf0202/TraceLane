{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracelane.dev/schemas/answer.schema.json",
  "title": "TraceLane Agent Answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "claims", "missing_information"],
  "properties": {
    "answer": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ids", "fact_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
