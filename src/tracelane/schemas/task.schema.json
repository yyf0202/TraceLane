{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracelane.dev/schemas/task.schema.json",
  "title": "TraceLane Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "question",
    "cutoff_at",
    "expected_facts",
    "completion_facts",
    "evidence",
    "future_evidence_ids",
    "fault_scenario",
    "license"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "cutoff_at": {"type": "string", "format": "date-time", "minLength": 1},
    "expected_facts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "completion_facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "available_at",
          "source",
          "text",
          "fact_ids"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "available_at": {"type": "string", "format": "date-time", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "future_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fault_scenario": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "license": {"type": "string", "minLength": 1}
  }
}
